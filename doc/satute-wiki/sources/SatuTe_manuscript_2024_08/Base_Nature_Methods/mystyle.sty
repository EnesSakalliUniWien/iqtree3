%%The bigcirc symbol
\makeatletter
\newcommand{\bigcomp}{%
  \DOTSB
  \mathop{\vphantom{\sum}\mathpalette\bigcomp@\relax}%
  \slimits@
}
\newcommand{\bigcomp@}[2]{%
  \begingroup\m@th
  \sbox\z@{$#1\sum$}%
  \setlength{\unitlength}{0.9\dimexpr\ht\z@+\dp\z@}%
  \vcenter{\hbox{%
    \begin{picture}(1,1)
    \bigcomp@linethickness{#1}
    \put(0.5,0.5){\circle{1}}
    \end{picture}%
  }}%
  \endgroup
}
\newcommand{\bigcomp@linethickness}[1]{%
  \linethickness{%
      \ifx#1\displaystyle 2\fontdimen8\textfont\else
      \ifx#1\textstyle 1.65\fontdimen8\textfont\else
      \ifx#1\scriptstyle 1.65\fontdimen8\scriptfont\else
      1.65\fontdimen8\scriptscriptfont\fi\fi\fi 3
  }%
}


% Custom command for the special section "Methods"
\newcommand{\specialsection}[1]{
  \setcounter{section}{13} % Set the counter to 12 (so the next section will be "M")
  \section*{#1} % No section number for the special section itself
  \addcontentsline{toc}{section}{#1} % Add section to the table of contents
  \renewcommand\thesubsection{\Alph{section}.\arabic{subsection}} % Use "M" for subsections
  \renewcommand\thesubsubsection{\Alph{section}.\arabic{subsection}.\arabic{subsubsection}} % Use "M" for sub-subsections
  \setcounter{subsection}{0} % Reset subsection counter for the special section
  \setcounter{subsubsection}{0} % Reset sub-subsection counter for the special section
}

% Command to reset section and subsection numbering after the special section
\newcommand{\resetsections}{
  \renewcommand\thesection{\arabic{section}} % Reset to numeric section numbering
  \renewcommand\thesubsection{\thesection.\arabic{subsection}} % Reset to numeric subsection numbering
  \renewcommand\thesubsubsection{\thesection.\arabic{subsection}.\arabic{subsubsection}} % Reset to numeric sub-subsection numbering
  \setcounter{section}{0} % Reset section counter
  \setcounter{subsection}{0} % Reset subsection counter
  \setcounter{subsubsection}{0} % Reset sub-subsection counter
}


