{
  "schema_version": 1,
  "id": "002_relative_weighting",
  "question": "How does relative eigenvalue weighting change SatuTe decisions under rate heterogeneity?",
  "status": "reviewed",
  "driver": "run.py",
  "workflow": "workflow.py",
  "consumers": [
    "manuscript"
  ],
  "studies": [
    {
      "id": "gtr_power",
      "question": "How does relative weighting change power under matched GTR, GTR+G4, and GTR+I+G4 models?",
      "outcome": "power",
      "scale": "cluster"
    },
    {
      "id": "protein_power",
      "question": "How does relative weighting change power under matched empirical protein models with G4?",
      "outcome": "power",
      "scale": "cluster"
    },
    {
      "id": "misspecification_power",
      "question": "How robust is power when GTR data are evaluated under GTR, JC, K2P, or F81?",
      "outcome": "power",
      "scale": "cluster"
    },
    {
      "id": "fdr_exact_null",
      "question": "Does each decision rule control false positives on held-out exact-null replicates?",
      "outcome": "calibration",
      "scale": "cluster"
    },
    {
      "id": "fdr_mixed_null",
      "question": "What FDR and power does each rule attain in the prespecified mixed-null design?",
      "outcome": "power",
      "scale": "cluster"
    }
  ],
  "default_study": "gtr_power",
  "config": {
    "schema_version": 2,
    "paired": true,
    "fdr_calibration_required_before_claim": true,
    "output": "artifacts/local/relative-weighting",
    "decision_rules": [
      "unadjusted",
      "taxon_bonferroni",
      "by_fdr"
    ],
    "plot_contract": {
      "independent_formula_figures": true,
      "paired_difference_figures": true,
      "static_2d": [
        "pdf",
        "svg",
        "png"
      ],
      "static_3d": [
        "pdf"
      ],
      "interactive_3d": [
        "html"
      ]
    },
    "publication_curve_design": {
      "replicates_per_cell": 1000,
      "tree_cases": [
        "five_external",
        "sixteen_internal"
      ],
      "site_lengths": [
        100,
        250,
        1000
      ],
      "branch_lengths": [
        4,
        5,
        6,
        7,
        8,
        9,
        10,
        12
      ],
      "simulator": "alisim",
      "studies": {
        "gtr_power": {
          "scenario_set": "fig2",
          "model_pairs": [
            "GTR_PF06346:GTR_PF06346",
            "GTR_PF06346_G4:GTR_PF06346_G4",
            "GTR_PF06346_I_G4:GTR_PF06346_I_G4"
          ]
        },
        "protein_power": {
          "scenario_set": "fig2",
          "model_pairs": [
            "LG_G4:LG_G4",
            "WAG_G4:WAG_G4",
            "JTT_G4:JTT_G4",
            "Q.PFAM_G4:Q.PFAM_G4"
          ]
        },
        "misspecification_power": {
          "scenario_set": "misspecification",
          "model_pairs": [
            "GTR_PF06346:GTR_PF06346",
            "GTR_PF06346:JC",
            "GTR_PF06346:K2P",
            "GTR_PF06346:F81"
          ]
        }
      }
    },
    "fdr_calibration_design": {
      "separate_from_publication_curves": true,
      "models": [
        "JC",
        "GTR_PF06346"
      ],
      "tree_cases": [
        "five_external",
        "sixteen_internal"
      ],
      "site_lengths": [
        100,
        1000
      ],
      "branch_lengths": [
        4,
        8
      ],
      "rate_mixture_scope": "homogeneous_fixed_DNA_only",
      "exact_null_replicates_per_cell": 5000,
      "exact_null_training_replicates": 2500,
      "exact_null_holdout_replicates": 2500,
      "mixed_null_replicates_per_cell": 2000,
      "mixed_null_target_fraction": 0.5,
      "truth_labels_keyed_by": "normalized_split",
      "required_rules": [
        "unadjusted",
        "taxon_bonferroni",
        "by_fdr"
      ]
    }
  }
}
